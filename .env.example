# Copy to .env and fill in only what you use. Never commit real keys.

# Affirm authorization without passing --i-am-authorized each time (use with care)
# ARGUS_AUTHORIZED=false

# Default target / rate limit
# ARGUS_TARGET=https://example.com
# ARGUS_RPS=10

# AI providers (optional — Argus runs fully without any of these)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Ollama needs no key; run a local model instead.
